# Copy this file to .env.local and populate values through your secret manager.
# Never commit a populated environment file.

# Client-safe values only. These are embedded in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
API_KEY_HASH_SECRET=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
DATA_ENCRYPTION_KEY=
RATEHUB_API_KEY=
FREDDIE_MAC_API_KEY=
