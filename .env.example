# Copy this file to .env.local and populate values through your secret manager.
# Never commit a populated environment file.

# Client-safe values only. These are embedded in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
API_KEY_HASH_SECRET=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe publishes client-side keys separately. The server payment endpoint only
# accepts the fixed rate_check catalog item and requires Idempotency-Key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Open banking is Plaid Link. Set this only after the privacy notice, consent
# text, provider agreement, and registered redirect/webhook URLs are live.
OPEN_BANKING_PROVIDER=plaid
OPEN_BANKING_CLIENT_NAME=MortgageMatch Pro
OPEN_BANKING_TOKEN_ENCRYPTION_KEY=
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_COUNTRY_CODES=CA
PLAID_PRODUCTS=transactions
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
REDIS_URL=
DATA_ENCRYPTION_KEY=
RATEHUB_API_KEY=
FREDDIE_MAC_API_KEY=
