{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "pages/_app.page.tsx",
    "pages/_document.page.tsx",
    "pages/index.page.tsx",
    "pages/404.page.tsx",
    "pages/500.page.tsx",
    "pages/api/affordability.page.ts",
    "pages/api/calculate.page.ts",
    "pages/api/health.page.ts",
    "pages/api/healthz.page.ts",
    "pages/api/v2/**/*.page.ts",
    "lib/server/**/*.ts",
    "proxy.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
